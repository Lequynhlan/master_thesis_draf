# Public source metadata: VNBA reports 01/10/2026 10:11 GMT, equivalent to UTC.
# availableAt uses publishedAt as a proxy because no first-seen ingestion log is available.
wfkg:vnba a wfkg:NewsSource ;
    wfkg:sourceId "vnba"^^xsd:string ;
    wfkg:sourceName "Hiệp hội Ngân hàng Việt Nam (VNBA)"^^xsd:string ;
    wfkg:sourceType "news-media"^^xsd:string ;
    # Contract-required fixture baseline only; this is not a measured reliability score.
    wfkg:reliabilityScore "0.5"^^xsd:decimal .

wfkg:article_vnba_hdb_dividend_2026_10_01 a wfkg:NewsArticle ;
    wfkg:articleId "vnba-2026-10-01-hdb-stock-dividend-record-date"^^xsd:string ;
    wfkg:title "HDBank phát hành hơn 1,5 tỷ cổ phiếu trả cổ tức và tăng vốn, chốt danh sách cổ đông ngày 12/10/2026"^^xsd:string ;
    wfkg:url <https://vnba.org.vn/vi/hdbank-phat-hanh-hon-1-5-ty-co-phieu-tra-co-tuc-va-tang-von--chot-danh-sach-co-dong-ngay-12-10-2026-23749.htm> ;
    wfkg:publishedBy wfkg:vnba ;
    wfkg:publishedAt "2026-10-01T10:11:00Z"^^xsd:dateTime ;
    wfkg:availableAt "2026-10-01T10:11:00Z"^^xsd:dateTime ;
    wfkg:reports wfkg:event_hdb_stock_dividend_record_2026_10_12 .


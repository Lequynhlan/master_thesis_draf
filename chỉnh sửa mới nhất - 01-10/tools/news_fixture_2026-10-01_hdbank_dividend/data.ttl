# Canonical identity uses the dictionary's DIVIDEND key order. The record-date
# assertion is associated with the HDBank notice cited by VNBA; see TEST_PLAN.md
# for the remaining provenance/adjudication limitation.
wfkg:event_hdb_stock_dividend_record_2026_10_12 a wfkg:Event ;
    wfkg:eventId "event-hdb-dividend-2026-10-12"^^xsd:string ;
    wfkg:eventType "DIVIDEND"^^xsd:string ;
    wfkg:canonicalKey "DIVIDEND|https://example.org/wfkg/v1#company_hdbank|DECLARE_STOCK|2026-10-12|HDBANK:2319/2026/CV-HDBank"^^xsd:string ;
    wfkg:description "HDBank dự kiến trả cổ tức năm 2025 bằng cổ phiếu với tỷ lệ 25%; ngày đăng ký cuối cùng để lập danh sách cổ đông hưởng quyền là 2026-10-12. Tin cũng nêu riêng phương án phát hành thêm 5% từ quỹ dự trữ bổ sung vốn điều lệ; tỷ lệ tổng hai cấu phần là 30%."^^xsd:string ;
    wfkg:availableAt "2026-10-01T10:11:00Z"^^xsd:dateTime ;
    wfkg:effectiveTradingDate "2026-10-02"^^xsd:date ;
    wfkg:involvesCompany wfkg:company_hdbank .

wfkg:company_hdbank a wfkg:Company ;
    wfkg:companyId "HDBANK"^^xsd:string ;
    wfkg:fullName "Ngân hàng Thương mại cổ phần Phát triển Thành phố Hồ Chí Minh"^^xsd:string ;
    wfkg:shortName "HDBank"^^xsd:string ;
    wfkg:companyType "BANK"^^xsd:string ;
    wfkg:hasStock wfkg:stock_hdb .

# The article reports ticker HDB. The source-backed edge is retained for query
# coverage, but is not asserted to be a versioned registry mapping for Candidate use.
wfkg:stock_hdb a wfkg:Stock ;
    wfkg:stockId "HDB"^^xsd:string ;
    wfkg:tickerSymbol "HDB"^^xsd:string ;
    wfkg:exchange "HOSE"^^xsd:string .


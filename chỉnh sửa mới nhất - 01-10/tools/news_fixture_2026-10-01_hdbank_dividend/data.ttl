    wfkg:evidenceText "Trả cổ tức bằng cổ phiếu: 1.251.319.080 cổ phiếu, giá trị 12.513.190.800.000 đồng, tỷ lệ thực hiện quyền 100:25"^^xsd:string ;
    wfkg:availableAt "2026-10-01T10:11:00Z"^^xsd:dateTime ;

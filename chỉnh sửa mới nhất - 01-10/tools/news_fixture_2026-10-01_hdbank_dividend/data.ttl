    wfkg:extractedFrom wfkg:article_vnba_hdb_dividend_2026_10_01 ;
    wfkg:supports wfkg:event_hdb_stock_dividend_record_2026_10_12 .

wfkg:evidence_vnba_hdb_notice_id_2026_10_01 a wfkg:Evidence ;

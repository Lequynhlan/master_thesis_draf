        <mxCell id="weTA0hvWxfCujyoZNfAk-11" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.8;fontSize=18;align=center;verticalAlign=middle;fontStyle=1;" value="Trong baseline hiện tại, relationPath phải bằng impactType; mỗi Candidate mang một trong bốn route code DIRECT, INDIRECT_INDUSTRY, INDIRECT_SUBSIDIARY hoặc INDIRECT_LEADERSHIP. Tất cả trước hết tạo EventStockCandidate. Candidate ranking chỉ dùng candidateScore tại inferenceCutoff. EventStockReaction chỉ được tạo sau khi đủ market data, benchmark và event window; reactionWeight không được dùng để tạo hoặc xếp hạng Candidate." vertex="1">
          <mxGeometry height="70" width="1510" x="60" y="1015" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

          <mxGeometry height="115" width="390" x="1140" y="220" as="geometry" />
        </mxCell>
        <mxCell id="weTA0hvWxfCujyoZNfAk-5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.8;fontSize=18;align=left;verticalAlign=top;spacing=14;" value="&lt;b&gt;THEO NGÀNH&lt;/b&gt; | &lt;font&gt;&lt;b&gt;Event → Industry ← IndustryExposure ← Bank → Stock ⇒ EventStockCandidate&lt;/b&gt;&lt;/font&gt; | Ngân hàng có mức phơi nhiễm với ngành được Event đề cập." vertex="1">
          <mxGeometry height="145" width="1030" x="60" y="400" as="geometry" />
        </mxCell>
        <mxCell id="weTA0hvWxfCujyoZNfAk-6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.8;fontSize=18;fontSize=12;" value="impactType&lt;br&gt;&lt;b&gt;INDIRECT_INDUSTRY&lt;/b&gt;&lt;br&gt;&lt;div&gt;&lt;br/&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="115" width="390" x="1150" y="415" as="geometry" />
        </mxCell>
        <mxCell id="weTA0hvWxfCujyoZNfAk-7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.8;fontSize=18;align=left;verticalAlign=top;spacing=14;" value="&lt;b&gt;THEO CÔNG TY CON&lt;/b&gt; | &lt;font&gt;&lt;b&gt;Event → Company (subsidiary) → SubsidiaryRelation → parent Company → Stock ⇒ EventStockCandidate&lt;/b&gt;&lt;/font&gt; | Event liên quan công ty con; ứng viên là cổ phiếu của công ty mẹ." vertex="1">
          <mxGeometry height="145" width="1030" x="60" y="595" as="geometry" />

        <mxCell id="bRsWfqp-iSm1W4H_WVv9-3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#fffdf0;strokeColor=#d6b656;fontColor=#18324b;fontSize=17;fontFamily=Arial;" value="&lt;b&gt;News &amp; provenance — ObjectProperty&lt;/b&gt;&lt;br&gt;&lt;br&gt;NewsArticle —publishedBy [1]→ NewsSource&lt;br&gt;NewsArticle —url [1]→ IRI&lt;br&gt;Evidence —extractedFrom [1]→ NewsArticle&lt;br&gt;Evidence —supports [1..*]→ Event&lt;br&gt;NewsArticle —reports [0..*]→ Event&lt;br&gt;Event —relatedEvent→ Event&lt;br&gt;Event —clarifies / updates / contradicts / supersedes→ Event&lt;br&gt;Event —issuedBy→ GovernmentOrganization&lt;br&gt;Event —referencesMetric→ FinancialMetric" vertex="1">
          <mxGeometry height="300" width="510" x="190" y="460" as="geometry" />
        </mxCell>
        <mxCell id="bRsWfqp-iSm1W4H_WVv9-4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#fffdf0;strokeColor=#d6b656;fontColor=#18324b;fontSize=17;fontFamily=Arial;" value="&lt;b&gt;Entities — ObjectProperty&lt;/b&gt;&lt;br&gt;&lt;br&gt;Event —involvesCompany (⊑ involves)→ Company&lt;br&gt;Event —involvesLeader (⊑ involves)→ CorporateLeader&lt;br&gt;Event —relatedToIndustry→ Industry&lt;br&gt;Company —hasAlias→ CompanyAlias&lt;br&gt;Company —hasSubsidiaryRelation→ SubsidiaryRelation&lt;br&gt;Company —hasFinancialMetric→ FinancialMetric&lt;br&gt;CorporateLeader —hasLeadershipPosition→ LeadershipPosition&lt;br&gt;LeadershipPosition —positionHolder→ CorporateLeader&lt;br&gt;LeadershipPosition —positionAtCompany→ Company&lt;br&gt;SubsidiaryRelation —subsidiaryCompany→ Company&lt;br&gt;SubsidiaryRelation —parentCompany→ Company&lt;br&gt;Company —belongsToIndustry→ Industry&lt;br&gt;Industry —belongsToGroup→ IndustryGroup" vertex="1">
          <mxGeometry height="365" width="540" x="745" y="460" as="geometry" />
        </mxCell>
        <mxCell id="bRsWfqp-iSm1W4H_WVv9-5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#fffdf0;strokeColor=#d6b656;fontColor=#18324b;fontSize=17;fontFamily=Arial;" value="&lt;b&gt;Market &amp; Event–Stock — ObjectProperty&lt;/b&gt;&lt;br&gt;&lt;br&gt;Company —hasStock→ Stock&lt;br&gt;Bank —hasIndustryExposure→ IndustryExposure&lt;br&gt;IndustryExposure —exposureBank→ Bank&lt;br&gt;IndustryExposure —exposureIndustry→ Industry&lt;br&gt;Stock —hasIndexMembership→ IndexMembership&lt;br&gt;IndexMembership —memberStock→ Stock&lt;br&gt;IndexMembership —memberIndex→ MarketIndex&lt;br&gt;Stock —hasMarketObservation→ MarketObservation&lt;br&gt;MarketIndex —hasIndexObservation→ MarketIndexObservation&lt;br&gt;Event —hasEventStockCandidate→ EventStockCandidate&lt;br&gt;EventStockCandidate —forEvent [1]→ Event&lt;br&gt;EventStockCandidate —candidateStock [1]→ Stock&lt;br&gt;EventStockCandidate —hasReaction→ EventStockReaction&lt;br&gt;EventStockReaction —onCandidate [1]→ EventStockCandidate&lt;br&gt;EventStockReaction —benchmarkIndex [1]→ MarketIndex&lt;br&gt;EventStockReaction —derivedFromObservation [1..*]→ MarketObservation&lt;br&gt;EventStockReaction —derivedFromIndexObservation [1..*]→ MarketIndexObservation" vertex="1">
          <mxGeometry height="465" width="575" x="1325" y="460" as="geometry" />
        </mxCell>
        <mxCell id="bRsWfqp-iSm1W4H_WVv9-6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#f7fbff;strokeColor=#9bb7d0;fontColor=#18324b;fontSize=17;fontFamily=Arial;" value="&lt;b&gt;DatatypeProperty — nội dung &amp; entity&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;NewsSource:&lt;/b&gt; sourceId, sourceName, sourceType, reliabilityScore&lt;br&gt;&lt;b&gt;NewsArticle:&lt;/b&gt; articleId, title, publishedAt, availableAt&lt;br&gt;&lt;b&gt;Evidence:&lt;/b&gt; evidenceId, evidenceText, startOffset, endOffset, availableAt&lt;br&gt;&lt;b&gt;Event:&lt;/b&gt; eventId, canonicalKey, eventType, description, occurredAt, availableAt, effectiveTradingDate, severityScore&lt;br&gt;&lt;b&gt;GovernmentOrganization:&lt;/b&gt; organizationId, organizationName&lt;br&gt;&lt;b&gt;CorporateLeader:&lt;/b&gt; personId, fullName&lt;br&gt;&lt;b&gt;LeadershipPosition:&lt;/b&gt; positionTitle&lt;br&gt;&lt;b&gt;Company/Bank:&lt;/b&gt; companyId, fullName, shortName, companyType&lt;br&gt;&lt;b&gt;CompanyAlias:&lt;/b&gt; aliasId, aliasName, aliasType&lt;br&gt;&lt;b&gt;Stock:&lt;/b&gt; stockId, tickerSymbol, exchange" vertex="1">
          <mxGeometry height="430" width="800" x="190" y="870" as="geometry" />
        </mxCell>

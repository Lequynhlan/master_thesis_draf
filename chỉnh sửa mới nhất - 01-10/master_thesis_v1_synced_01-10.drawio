        </mxCell>
        <mxCell id="izqzSf6VaLfidQc68PAD-18" connectable="0" parent="izqzSf6VaLfidQc68PAD-17" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=16;fontStyle=1;labelBackgroundColor=#ffffff;" value="derivedFromIndexObservation" vertex="1">
          <mxGeometry relative="1" y="-1" as="geometry" />
        </mxCell>
        <mxCell id="izqzSf6VaLfidQc68PAD-19" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#fffdf0;strokeColor=#d6b656;strokeWidth=1.5;fontSize=18;" value="&lt;font face=&quot;Helvetica&quot;&gt;&lt;b&gt;THÔNG TIN LƯU TRONG EVENTSTOCKCANDIDATE&lt;/b&gt;&lt;br&gt;• candidateId, impactType, relationPath, candidateReason, expectedDirection&lt;br&gt;• sourceConfidence, extractionConfidence, linkingConfidence, relationConfidence&lt;br&gt;• confidenceScore, relationStrength, candidateScore&lt;br&gt;• Phase 1: reliabilityScore/sourceConfidence = 0.5; source calibration dùng methodVersion mở rộng sau&lt;br&gt;• inferenceCutoff, generatedAt, availableAt, methodVersion, candidateStatus&lt;/font&gt;&lt;div&gt;&lt;pre dir=&quot;ltr&quot;&gt;&lt;code&gt;&lt;font face=&quot;Helvetica&quot;&gt;candidateStatus:&lt;br&gt;GENERATED | VALIDATED | REJECTED |&lt;br&gt;PENDING_MARKET_WINDOW | REACTION_READY&lt;/font&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="280" width="720" x="-770" y="1100" as="geometry" />
        </mxCell>
        <mxCell id="izqzSf6VaLfidQc68PAD-20" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.5;fontSize=18;" value="&lt;b&gt;THÔNG TIN LƯU TRONG EVENTSTOCKREACTION&lt;/b&gt;&lt;br&gt;• windowStartOffset/windowEndOffset; đủ t_(a−1), t_a…t_b và cùng ngày giữa stock–benchmark&lt;br&gt;• abnormalReturn = AR(i,0); cumulativeAbnormalReturn = Σ AR(i,t), t∈[a,b]&lt;br&gt;• derivedFromObservation/derivedFromIndexObservation; đúng Stock/benchmark và ngày&lt;br&gt;• linked observations carry adjustedClose + sourceReference; marketReactionDirection&lt;br&gt;• impactScore, reactionWeight, signedWeight; methodVersion, availableAt&lt;br&gt;• Reaction không dùng để ranking Candidate" vertex="1">
          <mxGeometry height="255" width="720" x="50" y="1100" as="geometry" />
        </mxCell>
        <mxCell id="izqzSf6VaLfidQc68PAD-21" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.8;fontSize=18;align=center;verticalAlign=middle;fontStyle=1;" value="Luồng chính: Event → EventStockCandidate → Stock; candidateScore = confidenceScore × relationStrength tại inference time. Sau khi đủ dữ liệu và event window, EventStockCandidate → EventStockReaction; reactionWeight = impactScore × confidenceScore × relationStrength. Reaction nối ngược bằng onCandidate và không cập nhật Candidate lịch sử." vertex="1">

        <mxCell id="mZ28CVNe_N0uJWWchiWa-39" edge="1" parent="1" source="mZ28CVNe_N0uJWWchiWa-27" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeWidth=1.8;strokeColor=#555555;labelBackgroundColor=#ffffff;fontSize=18;" target="mZ28CVNe_N0uJWWchiWa-32">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="mZ28CVNe_N0uJWWchiWa-40" edge="1" parent="1" source="mZ28CVNe_N0uJWWchiWa-28" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeWidth=1.8;strokeColor=#555555;labelBackgroundColor=#ffffff;fontSize=18;" target="mZ28CVNe_N0uJWWchiWa-30">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="mZ28CVNe_N0uJWWchiWa-41" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#fffdf0;strokeColor=#d6b656;strokeWidth=1.8;fontSize=18;" value="ĐẦU RA CỦA PIPELINE wfkg:EventStockCandidate • candidateId, impactType, relationPath, expectedDirection • sourceConfidence, extractionConfidence, linkingConfidence, relationConfidence • confidenceScore, relationStrength, candidateScore • inferenceCutoff, methodVersion, candidateStatus wfkg:EventStockReaction • chỉ tạo sau khi đủ market data, benchmark và event window • AR/CAR, impactScore, reactionWeight, signedWeight • provenance" vertex="1">
          <mxGeometry height="320" width="420" x="1360" y="370" as="geometry" />
        </mxCell>
        <mxCell id="mZ28CVNe_N0uJWWchiWa-42" edge="1" parent="1" source="mZ28CVNe_N0uJWWchiWa-33" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#006EAF;fontSize=18;fontStyle=1;labelBackgroundColor=#ffffff;" target="mZ28CVNe_N0uJWWchiWa-41" value="Kết quả có thể truy vết">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="mZ28CVNe_N0uJWWchiWa-43" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#f5f5f5;strokeColor=#b85450;strokeWidth=2;fontSize=18;" value="&lt;b&gt;NGUYÊN TẮC DIỄN GIẢI&lt;/b&gt;&lt;br&gt;&lt;br&gt;Ontology ghi nhận ứng viên liên hệ và phản ứng giá quan sát được. Nó không tự động chứng minh sự kiện là nguyên nhân làm giá cổ phiếu biến động." vertex="1">
          <mxGeometry height="205" width="420" x="1345" y="800" as="geometry" />
        </mxCell>
        <mxCell id="mZ28CVNe_N0uJWWchiWa-44" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=18;" value="&lt;b&gt;PHẠM VI V1&lt;/b&gt;&lt;br&gt;Ngân hàng thuộc VN30 theo từng thời kỳ; bốn đường liên hệ: DIRECT, INDIRECT_INDUSTRY, INDIRECT_SUBSIDIARY, INDIRECT_LEADERSHIP." vertex="1">
          <mxGeometry height="175" width="360" x="245" y="950" as="geometry" />
        </mxCell>
        <mxCell id="mZ28CVNe_N0uJWWchiWa-45" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=18;fontStyle=1;" value="Baseline 1.0.4: inferenceCutoff = Event.availableAt; input.availableAt ≤ inferenceCutoff.&lt;br&gt;generatedAt có thể muộn khi replay; Candidate score vẫn freeze tại cutoff + methodVersion.&lt;br&gt;Day 0: phiên đầu có sessionOpenAt &gt; Event.availableAt (calendar/version đã khóa).&lt;br&gt;Reaction: window đã đóng; observation.availableAt ≤ Reaction.availableAt, không dùng Candidate cutoff cho giá hậu nghiệm." vertex="1">
          <mxGeometry height="90" width="1450" x="225" y="1600" as="geometry" />
        </mxCell>
        <mxCell id="mZ28CVNe_N0uJWWchiWa-46" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="&lt;span id=&quot;docs-internal-guid-8dc67989-7fff-5925-8a71-3f38f4ecd96b&quot; style=&quot;font-size: 18px; white-space-collapse: preserve;&quot;&gt;&lt;font style=&quot;&quot; face=&quot;Times New Roman, serif&quot;&gt;&lt;b&gt;&lt;p dir=&quot;ltr&quot; style=&quot;line-height: 1.38; margin-top: 12pt; margin-bottom: 12pt;&quot;&gt;1. DIRECT — Sự kiện – Doanh nghiệp – Cổ phiếu&amp;nbsp;:&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Sự kiện liên quan trực tiếp đến một doanh nghiệp hoặc ngân hàng; cổ phiếu ứng viên là cổ phiếu do doanh nghiệp đó phát hành.&lt;/span&gt;&lt;/p&gt;&lt;p dir=&quot;ltr&quot; style=&quot;line-height: 1.38; margin-top: 12pt; margin-bottom: 12pt;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;2. INDIRECT_INDUSTRY — &lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-variant: normal; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); vertical-align: baseline;&quot;&gt;Event → Industry → Bank có IndustryExposure hợp lệ → Stock&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-variant: normal; font-weight: 400; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); vertical-align: baseline;&quot;&gt;: &lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-variant: normal; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); vertical-align: baseline;&quot;&gt;Baseline chỉ tạo ứng viên cho cổ phiếu Ngân hàng có IndustryExposure hợp lệ với ngành của Event; không suy rộng tới mọi cổ phiếu cùng ngành.&lt;/span&gt;&lt;/p&gt;&lt;p dir=&quot;ltr&quot; style=&quot;line-height: 1.38; margin-top: 12pt; margin-bottom: 12pt;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;3. INDIRECT_SUBSIDIARY — Sự kiện – Công ty con – Công ty mẹ – Cổ phiếu&amp;nbsp;&amp;nbsp;:&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Khi sự kiện liên quan đến công ty con, có thể tạo ứng viên là cổ phiếu của công ty mẹ thông qua quan hệ SubsidiaryRelation. Baseline chỉ xét chiều từ công ty con lên công ty mẹ, baseline hiện tại sẽ không suy luận chiều ngược lại.&lt;/span&gt;&lt;/p&gt;&lt;p dir=&quot;ltr&quot; style=&quot;line-height: 1.38; margin-top: 12pt; margin-bottom: 12pt;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;4. INDIRECT_LEADERSHIP — Sự kiện – Lãnh đạo – Doanh nghiệp – Cổ phiếu&amp;nbsp;&amp;nbsp;:&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp;Sự kiện liên quan đến một lãnh đạo được nối với doanh nghiệp thông qua LeadershipPosition; cổ phiếu được xem xét là cổ phiếu của doanh nghiệp mà người đó giữ chức vụ.&lt;/span&gt;&lt;/p&gt;&lt;/b&gt;&lt;/font&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="330" width="1570" x="165" y="1160" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

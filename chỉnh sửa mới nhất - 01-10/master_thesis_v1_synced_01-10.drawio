        <mxCell id="weTA0hvWxfCujyoZNfAk-9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.8;fontSize=18;align=left;verticalAlign=top;spacing=14;" value="&lt;b&gt;THEO LÃNH ĐẠO&lt;/b&gt; | &lt;font&gt;&lt;b&gt;Event → CorporateLeader → LeadershipPosition → Company → Stock ⇒ EventStockCandidate&lt;/b&gt;&lt;/font&gt; | Event liên quan lãnh đạo đang giữ chức vụ tại doanh nghiệp." vertex="1">

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix wfkg: <https://example.org/wfkg/v1#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

wfkg:BankShape a sh:NodeShape ;
    sh:property [ sh:class wfkg:IndustryExposure ;
            sh:path wfkg:hasIndustryExposure ] ;
    sh:targetClass wfkg:Bank .

wfkg:CompanyAliasShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path wfkg:aliasName ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path wfkg:aliasType ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path wfkg:aliasId ] ;
    sh:targetClass wfkg:CompanyAlias .

wfkg:CompanyShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path wfkg:companyType ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path wfkg:shortName ],
        [ sh:class wfkg:SubsidiaryRelation ;
            sh:path wfkg:hasSubsidiaryRelation ],
        [ sh:class wfkg:Stock ;
            sh:path wfkg:hasStock ],
        [ sh:class wfkg:FinancialMetric ;
            sh:path wfkg:hasFinancialMetric ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path wfkg:fullName ],
        [ sh:class wfkg:Industry ;
            sh:path wfkg:belongsToIndustry ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path wfkg:companyId ],
        [ sh:class wfkg:CompanyAlias ;
            sh:path wfkg:hasAlias ] ;
    sh:targetClass wfkg:Company .

wfkg:CorporateLeaderShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path wfkg:personId ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path wfkg:fullName ],
        [ sh:class wfkg:LeadershipPosition ;
            sh:path wfkg:hasLeadershipPosition ] ;
    sh:targetClass wfkg:CorporateLeader .

wfkg:EventShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:path wfkg:severityScore ],
        [ sh:class wfkg:Event ;
            sh:path wfkg:updates ],
        [ sh:class wfkg:EventStockCandidate ;
            sh:path wfkg:hasEventStockCandidate ],
        [ sh:class wfkg:CorporateLeader ;
            sh:path wfkg:involvesLeader ],
        [ sh:class wfkg:Industry ;
            sh:path wfkg:relatedToIndustry ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path wfkg:description ],
        [ sh:path wfkg:involves ],
        [ sh:class wfkg:GovernmentOrganization ;
            sh:path wfkg:issuedBy ],
        [ sh:class wfkg:Company ;
            sh:path wfkg:involvesCompany ],
        [ sh:class wfkg:Event ;
            sh:path wfkg:clarifies ],
        [ sh:class wfkg:FinancialMetric ;
            sh:path wfkg:referencesMetric ],
        [ sh:class wfkg:Event ;
            sh:path wfkg:supersedes ],
        [ sh:class wfkg:Event ;
            sh:path wfkg:contradicts ],
        [ sh:class wfkg:Event ;
            sh:path wfkg:relatedEvent ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path wfkg:eventId ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path wfkg:canonicalKey ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path wfkg:eventType ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:path wfkg:occurredAt ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path wfkg:availableAt ],
        [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path wfkg:effectiveTradingDate ] ;
    sh:sparql [ sh:message "Event requires supporting Evidence." ;
            sh:select "PREFIX wfkg: <https://example.org/wfkg/v1#> SELECT $this WHERE { FILTER NOT EXISTS { ?e wfkg:supports $this . } }" ],
        [ sh:message "Event availability must match earliest supporting Evidence." ;
            sh:select "PREFIX wfkg: <https://example.org/wfkg/v1#> SELECT $this WHERE { $this wfkg:availableAt ?t . { SELECT $this (MIN(?v) AS ?earliest) WHERE { ?e wfkg:supports $this ; wfkg:availableAt ?v . } GROUP BY $this } FILTER(?t != ?earliest) }" ],
        [ sh:message "Event requires reporting Article." ;
            sh:select "PREFIX wfkg: <https://example.org/wfkg/v1#> SELECT $this WHERE { FILTER NOT EXISTS { ?a wfkg:reports $this . } }" ],
        [ sh:message "Event–Event relations must not self-reference."@en ;
            sh:select """PREFIX wfkg: <https://example.org/wfkg/v1#>
            SELECT $this WHERE { $this ?relation $this .
              FILTER (?relation IN (wfkg:updates, wfkg:clarifies, wfkg:supersedes, wfkg:contradicts, wfkg:relatedEvent))
            }
        """ ] ;
    sh:targetClass wfkg:Event .

wfkg:EventStockCandidateShape a sh:NodeShape ;
    sh:property [ sh:class wfkg:EventStockReaction ;
            sh:path wfkg:hasReaction ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path wfkg:candidateId ],
        [ sh:class wfkg:Event ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path wfkg:forEvent ],
        [ sh:class wfkg:Stock ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path wfkg:candidateStock ],
        [ sh:datatype xsd:string ;
            sh:in ( "DIRECT" "INDIRECT_INDUSTRY" "INDIRECT_SUBSIDIARY" "INDIRECT_LEADERSHIP" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path wfkg:impactType ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path wfkg:relationPath ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path wfkg:candidateReason ],
        [ sh:datatype xsd:string ;
            sh:in ( "POSITIVE" "NEGATIVE" "NEUTRAL" "UNKNOWN" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path wfkg:expectedDirection ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:maxInclusive 1 ;
            sh:minCount 1 ;
            sh:minInclusive 0 ;
            sh:path wfkg:relationStrength ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:maxInclusive 1 ;
            sh:minCount 1 ;
            sh:minInclusive 0 ;
            sh:path wfkg:confidenceScore ],
        [ sh:datatype xsd:decimal ; sh:maxCount 1 ; sh:minCount 1 ; sh:minInclusive 0 ; sh:maxInclusive 1 ; sh:path wfkg:sourceConfidence ],
        [ sh:datatype xsd:decimal ; sh:maxCount 1 ; sh:minCount 1 ; sh:minInclusive 0 ; sh:maxInclusive 1 ; sh:path wfkg:extractionConfidence ],
        [ sh:datatype xsd:decimal ; sh:maxCount 1 ; sh:minCount 1 ; sh:minInclusive 0 ; sh:maxInclusive 1 ; sh:path wfkg:linkingConfidence ],
        [ sh:datatype xsd:decimal ; sh:maxCount 1 ; sh:minCount 1 ; sh:minInclusive 0 ; sh:maxInclusive 1 ; sh:path wfkg:relationConfidence ],
        [ sh:datatype xsd:decimal ; sh:maxCount 1 ; sh:minCount 1 ; sh:minInclusive 0 ; sh:maxInclusive 1 ; sh:path wfkg:candidateScore ],
        [ sh:datatype xsd:string ;
            sh:in ( "GENERATED" "VALIDATED" "REJECTED" "PENDING_MARKET_WINDOW" "REACTION_READY" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path wfkg:candidateStatus ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path wfkg:inferenceCutoff ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path wfkg:generatedAt ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path wfkg:availableAt ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path wfkg:methodVersion ] ;
    sh:sparql [ sh:message "Candidate cutoff must be no earlier than its Event; generatedAt/availableAt must be ordered."@en ;
            sh:select """PREFIX wfkg: <https://example.org/wfkg/v1#>
            SELECT $this WHERE {
              $this wfkg:forEvent ?event ; wfkg:inferenceCutoff ?cutoff ; wfkg:generatedAt ?generated ; wfkg:availableAt ?available .
              ?event wfkg:availableAt ?eventAvailable .
              FILTER (?cutoff < ?eventAvailable || ?generated < ?cutoff || ?available < ?generated)
            }
        """ ],
        [ sh:message "candidateScore must equal confidenceScore × relationStrength."@en ;
            sh:select """PREFIX wfkg: <https://example.org/wfkg/v1#>
            SELECT $this WHERE {
              $this wfkg:candidateScore ?score ; wfkg:confidenceScore ?confidence ; wfkg:relationStrength ?strength .
              FILTER (ABS(?score - (?confidence * ?strength)) > 0.000000001)
            }
        """ ],
        [ sh:message "confidenceScore must be the mean of its four frozen components."@en ;
            sh:select """PREFIX wfkg: <https://example.org/wfkg/v1#>
            SELECT $this WHERE {
              $this wfkg:confidenceScore ?score ; wfkg:sourceConfidence ?source ;
                    wfkg:extractionConfidence ?extraction ; wfkg:linkingConfidence ?linking ;
                    wfkg:relationConfidence ?relation .
              FILTER (ABS(?score - ((?source + ?extraction + ?linking + ?relation) / 4)) > 0.000000001)
            }
        """ ],
        [ sh:message "REACTION_READY requires an inverse-linked Reaction." ;
            sh:select "PREFIX wfkg: <https://example.org/wfkg/v1#> SELECT $this WHERE { $this wfkg:candidateStatus \"REACTION_READY\" . FILTER NOT EXISTS { $this wfkg:hasReaction ?r . ?r wfkg:onCandidate $this . } }" ],

        [ sh:message "Candidate có Reaction phải ở trạng thái REACTION_READY."@vi ;
            sh:select """PREFIX wfkg: <https://example.org/wfkg/v1#>
\r
            SELECT $this WHERE {\r
              $this wfkg:hasReaction ?reaction ; wfkg:candidateStatus ?status .\r
              FILTER (?status != "REACTION_READY")\r
            }\r
        """ ] ;
    sh:targetClass wfkg:EventStockCandidate .

wfkg:EventStockReactionShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path wfkg:reactionId ],
        [ sh:class wfkg:EventStockCandidate ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path wfkg:onCandidate ],
        [ sh:class wfkg:MarketIndex ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path wfkg:benchmarkIndex ],
        [ sh:class wfkg:MarketObservation ;
            sh:minCount 1 ;
            sh:path wfkg:derivedFromObservation ],
        [ sh:class wfkg:MarketIndexObservation ;
            sh:minCount 1 ;
            sh:path wfkg:derivedFromIndexObservation ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path wfkg:windowStartOffset ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path wfkg:windowEndOffset ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path wfkg:abnormalReturn ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path wfkg:cumulativeAbnormalReturn ],
        [ sh:datatype xsd:string ;
            sh:in ( "POSITIVE" "NEGATIVE" "NEUTRAL" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path wfkg:marketReactionDirection ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:maxInclusive 1 ;
            sh:minCount 1 ;
            sh:minInclusive 0 ;
            sh:path wfkg:impactScore ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:maxInclusive 1 ;
            sh:minCount 1 ;
            sh:minInclusive 0 ;
            sh:path wfkg:reactionWeight ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:maxInclusive 1 ;
            sh:minCount 1 ;
            sh:minInclusive -1 ;
            sh:path wfkg:signedWeight ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path wfkg:methodVersion ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path wfkg:availableAt ] ;
    sh:sparql [ sh:message "windowEndOffset phải lớn hơn hoặc bằng windowStartOffset."@vi ;
            sh:select """PREFIX wfkg: <https://example.org/wfkg/v1#>
            SELECT $this WHERE {
              $this wfkg:windowStartOffset ?start ; wfkg:windowEndOffset ?end .
              FILTER (?end < ?start)
            }
        """ ],
        [ sh:message "Reaction availability must not precede its Candidate or any input observation."@en ;
            sh:select """PREFIX wfkg: <https://example.org/wfkg/v1#>
            SELECT $this WHERE {
              { $this wfkg:availableAt ?ready ; wfkg:onCandidate ?candidate .
                ?candidate wfkg:availableAt ?input . FILTER (?ready < ?input) }
              UNION
              { $this wfkg:availableAt ?ready ; wfkg:derivedFromObservation ?o .
                ?o wfkg:availableAt ?input . FILTER (?ready < ?input) }
              UNION
              { $this wfkg:availableAt ?ready ; wfkg:derivedFromIndexObservation ?o .
                ?o wfkg:availableAt ?input . FILTER (?ready < ?input) }
            }
        """ ],
        [ sh:message "For a single-day [0,0] window, AR must match the paired stock and benchmark returns."@en ;
            sh:select """PREFIX wfkg: <https://example.org/wfkg/v1#>
            SELECT $this WHERE {
              $this wfkg:windowStartOffset 0 ; wfkg:windowEndOffset 0 ;
                    wfkg:abnormalReturn ?ar ; wfkg:onCandidate ?candidate ;
                    wfkg:derivedFromObservation ?stockObs ;
                    wfkg:derivedFromIndexObservation ?indexObs .
              ?candidate wfkg:forEvent ?event .
              ?event wfkg:effectiveTradingDate ?date .
              ?stockObs wfkg:tradingDate ?date ; wfkg:returnValue ?stockReturn .
              ?indexObs wfkg:tradingDate ?date ; wfkg:returnValue ?indexReturn .
              FILTER (ABS(?ar - (?stockReturn - ?indexReturn)) > 0.000000001)
            }
        """ ],
        [ sh:message "For a [0,0] window, CAR must equal AR."@en ;
            sh:select """PREFIX wfkg: <https://example.org/wfkg/v1#>
            SELECT $this WHERE {
              $this wfkg:windowStartOffset 0 ; wfkg:windowEndOffset 0 ;
                    wfkg:abnormalReturn ?ar ; wfkg:cumulativeAbnormalReturn ?car .
              FILTER (?ar != ?car)
            }
        """ ],
        [ sh:message "Reaction weight must equal impactScore × Candidate confidence × relationStrength."@en ;
            sh:select """PREFIX wfkg: <https://example.org/wfkg/v1#>
            SELECT $this WHERE {
              $this wfkg:reactionWeight ?weight ; wfkg:impactScore ?impact ; wfkg:onCandidate ?candidate .
              ?candidate wfkg:confidenceScore ?confidence ; wfkg:relationStrength ?strength .
              FILTER (ABS(?weight - (?impact * ?confidence * ?strength)) > 0.000000001)
            }
        """ ],
        [ sh:message "signedWeight must follow the sign of cumulativeAbnormalReturn with epsilon=0."@en ;
            sh:select """PREFIX wfkg: <https://example.org/wfkg/v1#>
            SELECT $this WHERE {
              $this wfkg:cumulativeAbnormalReturn ?car ;
                    wfkg:reactionWeight ?weight ;
                    wfkg:signedWeight ?signed .
              FILTER ((?car > 0 && ABS(?signed - ?weight) > 0.000000001)
                   || (?car < 0 && ABS(?signed + ?weight) > 0.000000001)
                   || (?car = 0 && ABS(?signed) > 0.000000001))
            }
        """ ] ;
    sh:targetClass wfkg:EventStockReaction .

wfkg:EvidenceShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path wfkg:evidenceText ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:path wfkg:startOffset ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:path wfkg:endOffset ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path wfkg:availableAt ],
        [ sh:class wfkg:NewsArticle ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path wfkg:extractedFrom ],
        [ sh:class wfkg:Event ;
            sh:minCount 1 ;
            sh:path wfkg:supports ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path wfkg:evidenceId ] ;
    sh:sparql [ sh:message "Evidence offsets must be both absent or satisfy 0 <= startOffset < endOffset."@en ;
            sh:select """PREFIX wfkg: <https://example.org/wfkg/v1#>
            SELECT $this WHERE {
              OPTIONAL { $this wfkg:startOffset ?start }
              OPTIONAL { $this wfkg:endOffset ?end }
              FILTER (BOUND(?start) != BOUND(?end) || (BOUND(?start) && (?start < 0 || ?end <= ?start)))
            }
        """ ],
        [ sh:message "Evidence cannot be available before its source Article."@en ;
            sh:select """PREFIX wfkg: <https://example.org/wfkg/v1#>
            SELECT $this WHERE {
              $this wfkg:availableAt ?evidenceAt ; wfkg:extractedFrom ?article .
              ?article wfkg:availableAt ?articleAt .
              FILTER (?evidenceAt < ?articleAt)
            }
        """ ],
        [ sh:message "Evidence cannot be available before the Article publication time."@en ;
            sh:select """PREFIX wfkg: <https://example.org/wfkg/v1#>
            SELECT $this WHERE {
              $this wfkg:availableAt ?evidenceAt ; wfkg:extractedFrom ?article .
              ?article wfkg:publishedAt ?publishedAt .
              FILTER (?evidenceAt < ?publishedAt)
            }
        """ ] ;
    sh:targetClass wfkg:Evidence .

wfkg:FinancialMetricShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path wfkg:metricType ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path wfkg:metricValue ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path wfkg:unit ],
        [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path wfkg:periodEnd ],
        [ sh:datatype xsd:string ;
            sh:in ( "DAY" "MONTH" "QUARTER" "HALF_YEAR" "YEAR" "TRAILING_TWELVE_MONTHS" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path wfkg:periodType ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path wfkg:availableAt ],
        [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:path wfkg:periodStart ],
        [ sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path wfkg:sourceReference ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path wfkg:metricId ] ;
    sh:targetClass wfkg:FinancialMetric .

wfkg:GovernmentOrganizationShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path wfkg:organizationId ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path wfkg:organizationName ] ;
    sh:targetClass wfkg:GovernmentOrganization .

wfkg:IndexMembershipShape a sh:NodeShape ;
    sh:node wfkg:TemporalProvenanceShape ;
    sh:property [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path wfkg:availableAt ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path wfkg:dataQualityFlag ],
        [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:path wfkg:validTo ],
        [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path wfkg:validFrom ],
        [ sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path wfkg:sourceReference ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path wfkg:relationConfidence ],
        [ sh:class wfkg:Stock ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path wfkg:memberStock ],
        [ sh:class wfkg:MarketIndex ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path wfkg:memberIndex ] ;
    sh:targetClass wfkg:IndexMembership .

wfkg:IndustryExposureShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path wfkg:reportedCategory ],
        [ sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path wfkg:sourceReference ],
        [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:path wfkg:validTo ],
        [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:path wfkg:validFrom ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:maxInclusive 1 ;
            sh:minCount 1 ;
            sh:minInclusive 0 ;
            sh:path wfkg:relationConfidence ],
        [ sh:datatype xsd:string ;
            sh:in ( "DAY" "MONTH" "QUARTER" "HALF_YEAR" "YEAR" "TRAILING_TWELVE_MONTHS" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path wfkg:periodType ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path wfkg:dataQualityFlag ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path wfkg:availableAt ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:maxInclusive 1 ;
            sh:minCount 1 ;
            sh:minInclusive 0 ;
            sh:path wfkg:exposureRatio ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:maxInclusive 1 ;
            sh:minCount 1 ;
            sh:minInclusive 0 ;
            sh:path wfkg:exposureStrength ],
        [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path wfkg:periodEnd ],
        [ sh:class wfkg:Bank ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path wfkg:exposureBank ],
        [ sh:class wfkg:Industry ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path wfkg:exposureIndustry ] ;
    sh:targetClass wfkg:IndustryExposure .

wfkg:IndustryGroupShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path wfkg:industryGroupName ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path wfkg:taxonomyName ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path wfkg:industryGroupId ] ;
    sh:targetClass wfkg:IndustryGroup .

wfkg:IndustryShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path wfkg:industryName ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path wfkg:industryId ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path wfkg:industryCode ],
        [ sh:class wfkg:IndustryGroup ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path wfkg:belongsToGroup ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path wfkg:taxonomyName ] ;
    sh:targetClass wfkg:Industry .


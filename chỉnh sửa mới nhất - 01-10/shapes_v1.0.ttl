wfkg:TemporalProvenanceShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path wfkg:validFrom ],
        [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:path wfkg:validTo ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path wfkg:availableAt ],
        [ sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path wfkg:sourceReference ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:maxInclusive 1 ;
            sh:minCount 1 ;
            sh:minInclusive 0 ;
            sh:path wfkg:relationConfidence ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path wfkg:dataQualityFlag ] ;
    sh:sparql [ sh:message "validTo phải lớn hơn hoặc bằng validFrom."@vi ;
            sh:select """PREFIX wfkg: <https://example.org/wfkg/v1#>
\r
            SELECT $this WHERE {\r
              $this wfkg:validFrom ?from ; wfkg:validTo ?to .\r
              FILTER (?to < ?from)\r
            }\r
        """ ] .

